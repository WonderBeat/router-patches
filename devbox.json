{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "github-to-sops@latest",
    "ssh-to-age@latest",
    "sops@latest",
    "detect-secrets@latest"
  ],
  "shell": {
    "init_hook": [
      "export SOPS_AGE_KEY_FILE=\"$(pwd)/.key\""
    ],
    "scripts": {
      "sops-key": [
        "read -s SSH_TO_AGE_PASSPHRASE",
        "export SSH_TO_AGE_PASSPHRASE",
        "ssh-to-age -private-key -i $1 -o .key"
      ]
    }
  }
}
